# Gate receipts, sync receipts, pipeline state (rebuilt every refresh).
reports/gates/
reports/sync_receipt.json
reports/pipeline_state.json
# Cohort registry / manifests / holdout products (minted at submit/run time).
reports/cohort_registry/
reports/cohorts/
reports/holdout_receipts/
reports/validation/
