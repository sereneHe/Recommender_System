# ==============================================================================
# MLOps Project Environment Variables Template
# Instructions: Copy this file to '.env' and fill in your private credentials.
# DO NOT commit the actual '.env' file to version control.
# ==============================================================================

# --- Weights & Biases ---
# Find your API Key at: https://wandb.ai/authorize
WANDB_API_KEY=your_secret_wandb_api_key_here
WANDB_ENTITY=your_wandb_username_or_team_name
WANDB_PROJECT=breast-cancer-classification

# --- Project Environment Settings ---
# Set to 'development' or 'production'
ENV_MODE=development
LOG_LEVEL=DEBUG

# --- Google Cloud Settings ---
# Path to your Google Cloud service account key file
GOOGLE_APPLICATION_CREDENTIALS=".secret/gcp-key.json"
